# Copy to .env.local for local runs. On Vercel set the same names under Project -> Settings -> Environment Variables.
# With none of these set, the app runs in DEMO mode on sample data (any login works).

SPREADSHEET_ID=<id from docs.google.com/spreadsheets/d/<ID>/edit>
# The service-account key, either as raw JSON on one line ...
GOOGLE_SERVICE_ACCOUNT_JSON=
# ... or base64 of the JSON file (easier to paste):  base64 -w0 key.json   /   [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
GOOGLE_SERVICE_ACCOUNT_B64=

# Team logins: comma-separated email:password pairs
TEAM_USERS=asha@yourco.com:change-me-1,ravi@yourco.com:change-me-2
# Any long random string (signs the login cookie)
SESSION_SECRET=
